# Server
SERVER_PORT=8080
GIN_MODE=debug

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/transaction_service?sslmode=disable
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=transaction-service
KAFKA_NUM_PARTITIONS=12

# NIBSS Adapter
NIBSS_BASE_URL=https://api.nibss-plc.com.ng
NIBSS_API_KEY=your-nibss-api-key
NIBSS_SECRET_KEY=your-nibss-secret-key
NIBSS_TIMEOUT_SECONDS=30

# Fineract Adapter
FINERACT_BASE_URL=https://your-fineract-instance.com
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
FINERACT_TENANT_ID=default
FINERACT_TIMEOUT_SECONDS=30

# Retry Configuration
RETRY_ENABLED=true
MAX_RETRY_ATTEMPTS=3
BACKOFF_STRATEGY=exponential
BACKOFF_INITIAL_MS=1000
BACKOFF_MAX_MS=30000
